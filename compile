#!/usr/bin/env bash

if [[ $1 != "-l" ]]; then
    root="_site/"
    if [ ! -d $root ]; then
        mkdir $root
    fi
    cp -r css js img $root
fi

for f in src/*.typ; do
    if [ $f = src/index.typ ]; then
        outdir=$root
    else
        outdir="$root$(basename -s .typ $f)/"
        if [ ! -d $outdir ]; then
            mkdir $outdir
        fi
    fi
    echo compiling $f to "${outdir}index.html"
    typst compile $f --features html --format html --root . "${outdir}index.html"
done
